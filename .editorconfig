root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,txt,toml,cfg,ini}]
indent_style = space
indent_size = 4
end_of_line = lf

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2
end_of_line = lf

[*.sh]
indent_style = space
indent_size = 4
end_of_line = lf

[*.{ps1,bat,cmd}]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
